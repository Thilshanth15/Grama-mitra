# =====================================================================
# GRAMA MITRA — PRODUCTION ENVIRONMENT TEMPLATE
# =====================================================================
# Copy this to .env and fill in real values.
# NEVER commit .env to version control.
# Set these as environment variables in your deployment platform instead.
# =====================================================================

# ── Deployment Environment ─────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

# ── CORS: Comma-separated list of allowed frontend domains ─────────────
# Example: https://gramamitra.in,https://www.gramamitra.in
ALLOWED_ORIGINS=https://gramamitra.in

# ── AI Engine ──────────────────────────────────────────────────────────
# Google Gemini API key. Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_KEY_HERE

# Optional Cloud STT (leave blank to use mock fallback)
STT_API_KEY=

# Optional Cloud TTS (leave blank to use synthetic PCM fallback)
TTS_API_KEY=

# ── Exotel Telephony ───────────────────────────────────────────────────
# Get from: Exotel Dashboard → API Credentials
EXOTEL_ACCOUNT_SID=your_account_sid_here
EXOTEL_API_KEY=your_api_key_here
EXOTEL_API_TOKEN=your_api_token_here

# Your Exotel virtual phone number
EXOTEL_PHONE_NUMBER=+918000000000

# Public URLs — Replace with your actual deployed domain
EXOTEL_WEBSOCKET_URL=wss://your-api-domain.onrender.com/ws/exotel/voice
EXOTEL_WEBHOOK_URL=https://your-api-domain.onrender.com/api/telephony/webhook

# ── Telephony Mode Flags ───────────────────────────────────────────────
# Keep TELEPHONY_ENABLED=false until Exotel is fully configured and tested.
# Set to true ONLY after confirming WSS connectivity from Exotel dashboard.
TELEPHONY_ENABLED=false

# Keep TELEPHONY_MOCK_MODE=true for safe local and staging testing.
TELEPHONY_MOCK_MODE=true

# ── Audio Stream Specifications (Exotel Voicebot Standard) ─────────────
TELEPHONY_SAMPLE_RATE=8000
TELEPHONY_CHUNK_SIZE_MS=100

# ── Voice Activity Detection (VAD) ────────────────────────────────────
VAD_ENERGY_THRESHOLD=350
VAD_SILENCE_DURATION=1.1
VAD_MAX_SPEECH_DURATION=15.0

# ── Frontend (Vite build-time variables) ──────────────────────────────
# Set VITE_API_URL to your deployed backend URL in the frontend .env
VITE_API_URL=https://your-api-domain.onrender.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
