# =====================================================================
# GRAMA MITRA — ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================
# Copy this file to .env and fill in your credentials.
# NEVER COMMIT .env TO VERSION CONTROL OR EXPOSE SECRETS IN FRONTEND.
# =====================================================================

# ---------------------------------------------------------------------
# 1. EXOTEL AGENTSTREAM / VOICEBOT TELEPHONY
# ---------------------------------------------------------------------
# Found in your Exotel Dashboard -> API Credentials
EXOTEL_ACCOUNT_SID=your_exotel_account_sid_here
EXOTEL_API_KEY=your_exotel_api_key_here
EXOTEL_API_TOKEN=your_exotel_api_token_here

# Your Exotel Virtual Number (VN) assigned to the Voicebot flow
EXOTEL_PHONE_NUMBER=+918000000000

# Public URLs (Replace with your actual public HTTPS/WSS domain or ngrok tunnel)
EXOTEL_WEBHOOK_URL=https://your-domain.com/api/telephony/webhook
EXOTEL_WEBSOCKET_URL=wss://your-domain.com/ws/exotel/voice

# Telephony Mode:
# Set to 'true' only when live telco credentials & public WSS are ready
TELEPHONY_ENABLED=false

# Mock Mode:
# When 'true', runs local simulation without incurring telco charges or needing real Exotel calls
TELEPHONY_MOCK_MODE=true

# Audio Stream Specs (Exotel Voicebot Applet standard)
TELEPHONY_SAMPLE_RATE=8000
TELEPHONY_CHUNK_SIZE_MS=100

# Voice Activity Detection (VAD)
VAD_ENERGY_THRESHOLD=350
VAD_SILENCE_DURATION=1.1
VAD_MAX_SPEECH_DURATION=15.0

# ---------------------------------------------------------------------
# 2. AI ENGINES (GEMINI, STT, TTS)
# ---------------------------------------------------------------------
# Google Gemini API key for rural grounded generation
GEMINI_API_KEY=your_gemini_api_key_here

# Cloud STT (Optional: Google Cloud Speech / Whisper; mock fallback used if blank)
STT_API_KEY=your_stt_api_key_here

# Cloud TTS (Optional: Google Cloud Text-to-Speech; synthetic PCM fallback used if blank)
TTS_API_KEY=your_tts_api_key_here

# ---------------------------------------------------------------------
# 3. BACKEND & LOGGING
# ---------------------------------------------------------------------
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

# ---------------------------------------------------------------------
# 4. FRONTEND (Vite Environment Variables)
# ---------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_USE_LOCAL_AI=true
VITE_FIREBASE_PROJECT_ID=demo-project
